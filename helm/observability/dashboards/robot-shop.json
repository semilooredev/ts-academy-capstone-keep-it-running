{
  "uid": "robot-shop-overview",
  "title": "Robot Shop - Requests, Errors, Latency",
  "description": "Capstone 2 dashboard: request rate, errors and latency for Robot Shop, plus the availability SLI behind the 99.9% SLO.",
  "tags": [
    "robot-shop",
    "capstone",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Web availability - last 30 days (SLO 99.9%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time(probe_success{job=\"robot-shop-web-availability\"}[30d])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Synthetic availability SLI from the Blackbox probe of http://web.robot-shop.svc.cluster.local:8080/ every 30s. Error budget: 43.2 minutes per 30 days."
    },
    {
      "id": 2,
      "title": "Web availability - last 1 hour",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time(probe_success{job=\"robot-shop-web-availability\"}[1h])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "NGINX requests (web)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_http_requests_total{job=\"robot-shop-web\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Total requests served by Robot Shop's web NGINX since container start (nginx-prometheus-exporter sidecar)."
    },
    {
      "id": 4,
      "title": "Request rate by span (traces -> spanmetrics)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, span_name) (rate({__name__=~\"(.+_)?calls_total\"}[5m]))",
          "legendFormat": "{{service_name}} / {{span_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Derived from OpenTelemetry spans by the Collector's spanmetrics connector. Metric name is matched by regex so a spanmetrics namespace prefix cannot break the panel; confirm the exact name in Grafana Explore on the live cluster."
    },
    {
      "id": 5,
      "title": "Error ratio by span",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, span_name) (rate({__name__=~\"(.+_)?calls_total\", status_code=~\"(?i)error\"}[5m])) / sum by (service_name, span_name) (rate({__name__=~\"(.+_)?calls_total\"}[5m])) * 100",
          "legendFormat": "{{service_name}} / {{span_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "description": "Share of spans whose status is ERROR. The status_code label spelling is checked live in Explore; the regex tolerates ERROR/Error."
    },
    {
      "id": 6,
      "title": "Latency p50 / p95 / p99 (shipping spans)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"(.+_)?duration_milliseconds_bucket\"}[5m]))) / 1000",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"(.+_)?duration_milliseconds_bucket\"}[5m]))) / 1000",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"(.+_)?duration_milliseconds_bucket\"}[5m]))) / 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Span duration histogram from spanmetrics (le buckets are in milliseconds; divided by 1000 for seconds)."
    },
    {
      "id": 7,
      "title": "NGINX request rate (web)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nginx_http_requests_total{job=\"robot-shop-web\"}[5m]))",
          "legendFormat": "web requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Top spans by calls (5m)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service_name, span_name) (increase({__name__=~\"(.+_)?calls_total\"}[5m])))",
          "legendFormat": "{{service_name}} / {{span_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "The busiest traced operations in the last five minutes."
    }
  ]
}
